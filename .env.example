# Copy to .env and change what you need. Anything left out uses the default in config.py.
CHUNK_SIZE=400
CHUNK_OVERLAP=60
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_MODE=hybrid
USE_RERANKER=true
CANDIDATES=20
TOP_K=4
LLM_MODEL=llama3.1:8b
JUDGE_MODEL=llama3.1:8b
CONFIDENCE_THRESHOLD=-6.9

# Language model provider: ollama (local, free, the default) or openai (optional, much faster)
LLM_PROVIDER=ollama
# Used only when LLM_PROVIDER=openai. The API key goes in your private .env only, never in this file.
# OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
